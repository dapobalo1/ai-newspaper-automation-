# Atlantic Digest — AI Newspaper Automation
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — only commit this .env.example file.

# ── Claude AI ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── WordPress REST API ────────────────────────────────────────────────────────
WP_SITE_URL=https://your-wordpress-site.com
WP_USERNAME=your-wp-admin-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx   # Generate in WP Admin → Users → Profile → Application Passwords

# ── Images (Unsplash) ─────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=your-unsplash-access-key    # Free at unsplash.com/developers

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.your-email-provider.com          # e.g. smtp.gmail.com or secure.emailsrvr.com
SMTP_PORT=587
SMTP_USER=your-sending-email@yourdomain.com
SMTP_PASSWORD=your-email-password
EDITOR_EMAIL=editor@yourdomain.com
PUBLISHER_EMAIL=publisher@yourdomain.com

# ── Google Sheets ─────────────────────────────────────────────────────────────
# The ID is the long string in your Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your-google-sheet-id

# ── Pipeline Config ───────────────────────────────────────────────────────────
DAILY_ARTICLE_LIMIT=8
ARTICLE_MAX_AGE_HOURS=24
